<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with default ActionBar -->
    <style name="Theme.IOTBazaar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Component styles -->
        <item name="materialButtonStyle">@style/Widget.IOTBazaar.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.IOTBazaar.Fab</item>
    </style>
</resources>