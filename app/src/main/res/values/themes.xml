<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IOTBazaar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Palette -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System chrome -->
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:colorBackground">@color/surface_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_elevated</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <!-- Component styles -->
        <item name="materialButtonStyle">@style/Widget.IOTBazaar.Button</item>
        <item name="materialCardViewStyle">@style/Widget.IOTBazaar.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.IOTBazaar.Fab</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
